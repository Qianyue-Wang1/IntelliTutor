# ==================== Public entry ====================
# Production: domain only (Caddy automatically enables HTTPS), e.g. tutor.example.com
# IP-only smoke test: http://203.0.113.10
SITE_ADDRESS=tutor.example.com
PUBLIC_ORIGIN=https://tutor.example.com
# IANA timezone used by containers, JVM logs, and API date serialization (UTC+8).
TZ=Asia/Shanghai

# ==================== Infrastructure secrets ====================
# Replace every CHANGE_ME value before deployment. Hex-only values avoid Compose escaping issues.
POSTGRES_DB=intellitutor
POSTGRES_USER=intellitutor
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
REDIS_PASSWORD=CHANGE_ME_REDIS
RABBITMQ_USERNAME=intellitutor
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
NEO4J_PASSWORD=CHANGE_ME_NEO4J
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

# ==================== LLM provider ====================
# At least one provider needs URL, API key, and models for INSTRUCT/LARGE/SMALL/VL.
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_INSTRUCT=
OPENROUTER_MODEL_LARGE=
OPENROUTER_MODEL_SMALL=
OPENROUTER_MODEL_VL=
OPENROUTER_MODEL_VLFAST=
OPENROUTER_MODEL_REASONING=

MODELSCOPE_API_URL=
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL_INSTRUCT=
MODELSCOPE_MODEL_LARGE=
MODELSCOPE_MODEL_SMALL=
MODELSCOPE_MODEL_VL=
MODELSCOPE_MODEL_VLFAST=
MODELSCOPE_MODEL_REASONING=

QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL_INSTRUCT=
QWEN_MODEL_LARGE=
QWEN_MODEL_SMALL=
QWEN_MODEL_VL=
QWEN_MODEL_VLFAST=
QWEN_MODEL_REASONING=

SILICON_API_URL=
SILICON_API_KEY=
SILICON_MODEL_INSTRUCT=
SILICON_MODEL_LARGE=
SILICON_MODEL_SMALL=
SILICON_MODEL_VL=
SILICON_MODEL_VLFAST=
SILICON_MODEL_REASONING=

CEREBRAS_API_URL=
CEREBRAS_API_KEY1=
CEREBRAS_API_KEY2=
CEREBRAS_MODEL_INSTRUCT=

# ==================== Optional host model directory ====================
# The running experiment does not load local models, LoRA, or adapters. This bind mount is
# retained only for compatibility with offline research files and may stay empty.
MODEL_DIR=./models

# ==================== Email verification ====================
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ==================== Optional Aliyun phone verification ====================
ALIYUN_DYPNS_ENABLED=false
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_DYPNS_REGION=cn-shenzhen
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_SIGN_NAME=
ALIYUN_DYPNS_TEMPLATE_CODE= 

APP_LOG_LEVEL=INFO

# ==================== Product capabilities ====================
# Controls whether users may create new questions from images. Existing image
# sessions remain readable when disabled.
IMAGE_INPUT_ENABLED=false

# ==================== Human experiment ====================
EXPERIMENT_MODE=false
EXPERIMENT_ADMIN_ACCOUNT=experiment-admin
EXPERIMENT_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS
EXPERIMENT_INACTIVITY_MINUTES=10
